{:paths ["src"]
 ;; The OTP vault is a Datomic-API store: langchain ships a pure-.cljc,
 ;; dependency-free, Datomic-shaped EAV/Datalog engine (langchain.db) that
 ;; runs unchanged on JVM Clojure, ClojureScript (Node), SCI and WASM. The CLI
 ;; itself targets ClojureScript/Node (see shadow-cljs.edn); every namespace is
 ;; .cljc so the same logic is unit-tested on the JVM test-runner.
 ;; Pinned at schema-from-tx-data, which auth.db uses to state the vault
 ;; schema once, in the Datomic installation tx-data dialect the rest of this
 ;; workspace's datom corpora are declared in.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langchain
        {:git/sha "8789fe4cc387f294b6936f2171e419a252fd9ea8"}}
 :aliases
 {;; local checkout for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/langchain
                        {:local/root "../langchain"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; ClojureScript / Node build toolchain
  :cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
