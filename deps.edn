{:paths ["src"]
 ;; The OTP vault is a Datomic-API store: langchain-clj ships a pure-.cljc,
 ;; dependency-free, Datomic-shaped EAV/Datalog engine (langchain.db) that
 ;; runs unchanged on JVM Clojure, ClojureScript (Node), SCI and WASM. The CLI
 ;; itself targets ClojureScript/Node (see shadow-cljs.edn); every namespace is
 ;; .cljc so the same logic is unit-tested on the JVM test-runner.
 :deps {io.github.com-junkawasaki/langchain-clj
        {:git/tag "v0.1.1" :git/sha "044ecb2"}}
 :aliases
 {;; local checkout for workspace development (orgs/com-junkawasaki/*)
  :dev {:override-deps {io.github.com-junkawasaki/langchain-clj
                        {:local/root "../langchain"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; ClojureScript / Node build toolchain
  :cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}}}}}
